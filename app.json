{
  "expo": {
    "name": "SIAMP-G-Mobile",
    "slug": "SIAMP-G-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.png",
    "scheme": "siampgmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "main": "./App.tsx",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "package": "com.marcocaamal.SIAMPGMobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-wifi-reborn",
        {
          "fineLocationPermission": false
        }
      ]
    ]
  }
}
